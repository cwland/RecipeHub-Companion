{
  "manifest_version": 3,
  "name": "Culury Companion",
  "version": "0.2.0",
  "description": "Send recipes, links and notes from your browser to your Culury inbox.",
  "icons": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png" },
  "action": {
    "default_title": "Culury Companion",
    "default_popup": "src/popup/popup.html",
    "default_icon": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png" }
  },
  "options_ui": { "page": "src/options/options.html", "open_in_tab": true },
  "background": { "service_worker": "src/background/service_worker.js", "type": "module" },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "minimum_chrome_version": "116"
}
